// LXX521 TrustKernel stock prebuilts for the recovery ramdisk.
// ELF files must be modules, not PRODUCT_COPY_FILES.

cc_prebuilt_binary {
    name: "lxx521_teed",
    srcs: ["vendor/bin/teed"],
    stem: "teed",
    compile_multilib: "64",
    recovery: true,
    install_in_root: true,
    relative_install_path: "vendor/bin",
    strip: { none: true },
    check_elf_files: false,
}

cc_prebuilt_binary {
    name: "lxx521_keymint_service",
    srcs: ["vendor/bin/hw/android.hardware.security.keymint@3.0-service.trustkernel"],
    stem: "android.hardware.security.keymint@3.0-service.trustkernel",
    compile_multilib: "64",
    recovery: true,
    install_in_root: true,
    relative_install_path: "vendor/bin/hw",
    strip: { none: true },
    check_elf_files: false,
}

