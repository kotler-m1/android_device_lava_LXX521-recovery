# LAVA LXX521 (MT6878) - TrustKernel TEE / KeyMint AIDL 3.0 / Gatekeeper AIDL 1.0
# Recovery adaptation of the stock Android 15 TrustKernel startup configuration.
# EXPERIMENTAL: verify init triggers, TEE readiness and Android 34 ABI compatibility
# on-device before relying on recovery FBE decryption. No partition is formatted.

on init
    mkdir /mnt/vendor 0755 root root
    mkdir /mnt/vendor/persist 0750 system system
    mkdir /mnt/vendor/protect_f 0750 system system

# TrustKernel uses persist and protect1 for TEE-owned persistent state.
# Match the stock mount options; these commands only mount existing filesystems.
on post-fs
    wait /dev/block/by-name/persist 10
    wait /dev/block/by-name/protect1 10

    mount ext4 /dev/block/by-name/persist /mnt/vendor/persist rw noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc
    mount ext4 /dev/block/by-name/protect1 /mnt/vendor/protect_f rw noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc

    restorecon /mnt/vendor/persist
    restorecon /mnt/vendor/protect_f

    mkdir /mnt/vendor/persist/t6 0770 system system
    chown system system /mnt/vendor/persist/t6
    restorecon /mnt/vendor/persist/t6

    mkdir /mnt/vendor/protect_f/tee 0770 system system
    chown system system /mnt/vendor/protect_f/tee
    restorecon /mnt/vendor/protect_f/tee

    # These nodes are created by the TrustKernel/RPMB kernel modules.
    wait /dev/tkcore_admin 10
    wait /dev/tkcore_client 10
    wait /dev/rpmb0 10

    chmod 0600 /dev/tkcore_admin
    chown system system /dev/tkcore_admin
    chmod 0660 /dev/tkcore_client
    chown root system /dev/tkcore_client
    chmod 0660 /dev/rpmb0
    chown root system /dev/rpmb0

    start teed

# On normal Android, post-fs-data occurs after /data is mounted and before
# credential-encrypted user storage is unlocked. Recovery must be checked to
# confirm this trigger runs only after its /data mount is available.
on post-fs-data
    setprop vendor.trustkernel.fs.mode 3
    setprop vendor.trustkernel.fs.state prepare

on property:vendor.trustkernel.fs.state=prepare
    mkdir /data/vendor/t6 0770 system system
    chown system system /data/vendor/t6
    mkdir /data/vendor/t6/fs 0770 system system
    chown system system /data/vendor/t6/fs
    mkdir /data/vendor/t6/app 0770 system system
    chown system system /data/vendor/t6/app
    restorecon /data/vendor/t6
    restorecon /data/vendor/t6/fs
    restorecon /data/vendor/t6/app
    setprop vendor.trustkernel.fs.state ready

# KeyMint and Gatekeeper must not wait for the FBE user's credential unlock.
# Start them once teed has initialized its TrustKernel connection.
on property:vendor.trustkernel.ready=true
    start vendor.keymint-3-0-trustkernel
    start vendor.gatekeeper

service teed /vendor/bin/teed \
    --tzdev /dev/tkcore_admin \
    --datapath /data/vendor/t6/fs \
    --sptapath /data/vendor/t6/app \
    --systapath /vendor/app/t6 \
    --rpmbdev /dev/mmcblk0rpmb \
    --rpmbdev /dev/rpmb0 \
    --prot /mnt/vendor/persist/t6 \
    --prot /mnt/vendor/protect_f/tee \
    --prebuilt /vendor/app/t6/data \
    --logpath /data/vendor/t6/tkcore.log \
    --proprefix vendor.trustkernel
    class core
    user system
    group system
    capabilities SYS_RAWIO
    disabled

service vendor.keymint-3-0-trustkernel /vendor/bin/hw/android.hardware.security.keymint@3.0-service.trustkernel
    class early_hal
    user system
    group system
    disabled

service vendor.gatekeeper /vendor/bin/hw/android.hardware.gatekeeper-service.trustkernel
    class hal
    user system
    group system
    disabled
